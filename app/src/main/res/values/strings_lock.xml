<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy of the lock / unlock flow.

  The page titles, the sheet titles and the error messages follow the design
  (Moonvy "lock PDF", "lock密码输入", "lock输入", "lock错误", "密码输入",
  "密码错误", "lock密码可见输入_2", "Unlock", "Unlock-空"). Everything that
  already exists in the base strings (cancel / ok / view / share / result /
  no_items) is reused instead of being duplicated here.
-->
<resources>

    <!-- page titles -->
    <string name="lock_page_encrypt">加密 PDF</string>
    <string name="lock_page_select">选择文件</string>

    <!-- password sheet -->
    <string name="lock_set_password">设置密码</string>
    <string name="lock_set_password_hint">设置密码后，打开该文件需要验证密码</string>
    <string name="lock_remove_password">移除密码</string>
    <string name="lock_remove_password_hint">移除后将不再受密码保护</string>
    <string name="lock_enter_password">输入密码</string>
    <string name="lock_enter_password_hint">需要密码才能打开该文件</string>
    <string name="lock_password_hint">请输入密码</string>
    <string name="lock_password_too_short">密码至少需要 4 位</string>
    <string name="lock_toggle_password">显示密码</string>

    <!-- states -->
    <string name="lock_wrong_password">密码错误</string>
    <string name="lock_not_encrypted">该文件不是加密文档</string>
    <string name="lock_operation_failed">操作失败，请重试</string>

    <!-- file list -->
    <string name="lock_import">导入 PDF</string>
    <string name="lock_no_document">请先选择一个文件</string>

    <!-- result -->
    <string name="lock_result_path">路径：%1$s</string>
    <string name="lock_result_locked">PDF 已加密</string>
    <string name="lock_result_unlocked">PDF 已解密</string>
    <string name="lock_open_failed">没有找到可以打开该文件的应用</string>

</resources>
