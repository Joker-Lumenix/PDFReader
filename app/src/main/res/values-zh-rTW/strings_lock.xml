<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy of the lock / unlock flow.

  The page titles, the sheet titles and the error messages follow the design
  (Moonvy "lock PDF", "lock password input", "lock error", "password input",
  "password error", "Unlock", "Unlock-empty"). Everything that already exists
  in the base strings (cancel / ok / view / share / result / no_items) is
  reused instead of being duplicated here.
-->
<resources>

    <!-- page titles -->
    <string name="lock_page_encrypt">加密 PDF</string>
    <string name="lock_page_select">選擇檔案</string>

    <!-- password sheet -->
    <string name="lock_set_password">設定密碼</string>
    <string name="lock_set_password_hint">設定密碼後，開啟此檔案需要驗證密碼</string>
    <string name="lock_remove_password">移除密碼</string>
    <string name="lock_remove_password_hint">移除後將不再受密碼保護</string>
    <string name="lock_enter_password">輸入密碼</string>
    <string name="lock_enter_password_hint">需要密碼才能開啟此檔案</string>
