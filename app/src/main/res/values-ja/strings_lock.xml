<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy of the lock / unlock flow.

  The page titles, the sheet titles and the error messages follow the design
  (Moonvy "lock PDF", "lock password input", "lock error", "password input",
  "password error", "Unlock", "Unlock-empty"). Everything that already exists
  in the base strings (cancel / ok / view / share / result / no_items) is
  reused instead of being duplicated here.
-->
<resources>

    <!-- page titles -->
    <string name="lock_page_encrypt">PDF の暗号化</string>
    <string name="lock_page_decrypt">PDF の復号</string>

    <!-- password sheet -->
    <string name="lock_set_password">パスワードを設定</string>
    <string name="lock_set_password_hint">設定後、このファイルを開くにはパスワードが必要です</string>
    <string name="lock_remove_password">パスワードを削除</string>
    <string name="lock_remove_password_hint">削除後はパスワードで保護されません</string>
    <string name="lock_password_hint">パスワードを入力</string>
    <string name="lock_password_too_short">パスワードは 4 文字以上で入力してください</string>
    <string name="lock_clear_password">パスワードを消去</string>
    <string name="lock_toggle_password">パスワードを表示</string>

    <!-- states -->
    <string name="lock_wrong_password">パスワードが違います</string>
    <string name="lock_not_encrypted">このファイルは暗号化されていません</string>
    <string name="lock_operation_failed">操作に失敗しました。もう一度お試しください</string>
    <string name="lock_working">処理中…</string>
    <string name="lock_badge_encrypted">暗号化済み</string>

    <!-- file list -->
    <string name="lock_empty_hint">サンドボックスに処理できる PDF ファイルはまだありません</string>
    <string name="lock_import">PDF を読み込む</string>

    <!-- result -->
    <string name="lock_result_path">パス: %1$s</string>
    <string name="lock_open_failed">このファイルを開けるアプリが見つかりません</string>

</resources>
