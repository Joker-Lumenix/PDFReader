<?xml version="1.0" encoding="utf-8"?>
<!--
  An image tile of the "image to PDF" screen (design "Image to PDF").
  104x104, radius 4, with the index badge in the top left corner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="104dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_r4"
        android:contentDescription="@string/tools_image_select"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white" />

</FrameLayout>
