<?xml version="1.0" encoding="utf-8"?>
<!--
  An image tile of the "image to PDF" screen (design "Image to PDF").

  The three tiles of a row share the width of the screen, the tile is square
  in the design (104x104 on a 360 wide screen), so the height follows the
  width. The index badge sits in the top left corner.
-->
<com.peng.pdfreader.core.widget.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:ratio="1">

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_r4"
        android:clipToOutline="true"
        android:contentDescription="@string/tools_image_select"
        android:scaleType="centerCrop" />

    <!-- the camera tile of the design carries a 34x34 glyph in its centre -->
    <ImageView
        android:id="@+id/ivCamera"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:contentDescription="@string/tools_image_add"
        android:visibility="gone" />

    <!-- the badge of the design opens the picture in the processing page -->
    <ImageView
        android:id="@+id/ivExpand"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:contentDescription="@string/tools_image_expand"
        android:focusable="true"
        android:src="@mipmap/ic_scale_large"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white" />

</com.peng.pdfreader.core.widget.RatioFrameLayout>
