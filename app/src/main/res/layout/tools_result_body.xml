<?xml version="1.0" encoding="utf-8"?>
<!--
  The result page of the tool flows (designs "Merged Successfully!" and
  "压缩结果页").

  It is shared by the merge and the compress flow:
  - the hero carries the success title (merge) or the before / after sizes
    (compress), both live on the same 336x100 hero artwork
  - the file card shows the produced document with its share / view actions
  - the "more" card offers the follow up actions
  - the feedback card asks the user how the tool behaved
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- ==================== hero ==================== -->

        <FrameLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tools_result_view"
                android:src="@mipmap/bg_result" />

            <!-- merge variant -->
            <LinearLayout
                android:id="@+id/heroSuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/status_success"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivHeroMark"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/merged_success" />

            </LinearLayout>

            <!-- compress variant -->
            <LinearLayout
                android:id="@+id/heroStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSizeBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/status_warning"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvBeforePill"
                        android:layout_width="54dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivArrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/before"
                    android:src="@mipmap/ic_size_arrow" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSizeAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/status_info_blue6"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvAfterPill"
                        android:layout_width="54dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- ==================== produced document ==================== -->

        <FrameLayout
            android:id="@+id/fileCard"
            android:layout_width="match_parent"
            android:layout_height="174dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="62dp"
                android:layout_height="82dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/tools_result_view"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvPageBadge"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="44dp"
                android:layout_marginTop="82dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFileName"
                style="@style/TextAppearance.AppCore.ItemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="86dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="44dp"
                android:ellipsize="middle"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvFilePath"
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="86dp"
                android:layout_marginTop="58dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="middle"
                android:maxLines="1" />

            <FrameLayout
                android:id="@+id/btnRename"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_tile"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/rename_file"
                    android:src="@mipmap/ic_rename_black" />

            </FrameLayout>

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="145dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_btn_unable_r16"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnView"
                android:layout_width="145dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/gradient_red"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

        </FrameLayout>

        <!-- ==================== more actions ==================== -->

        <LinearLayout
            android:id="@+id/moreCard"
            android:layout_width="match_parent"
            android:layout_height="204dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_r8"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/TextAppearance.AppCore.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tools_result_more" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cellOpenWith"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_open_with"
                            android:src="@mipmap/ic_open_with" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_open_with"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellPrint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_print"
                            android:src="@mipmap/ic_print" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_print"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellDraw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_draw"
                            android:src="@mipmap/ic_draw_red" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_draw"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cellCompress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_compress"
                            android:src="@mipmap/ic_compress" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_compress"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellSign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_sign"
                            android:src="@mipmap/ic_sign_red" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_sign"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellLock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_tile">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/tools_result_lock"
                            android:src="@mipmap/ic_lock" />

                    </FrameLayout>

                    <TextView
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/tools_result_lock"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== feedback ==================== -->

        <FrameLayout
            android:id="@+id/feedbackCard"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="51dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_r8">

            <TextView
                android:id="@+id/tvFeedback"
                style="@style/TextAppearance.AppCore.ItemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="32dp"
                android:maxLines="2"
                android:text="@string/tools_result_feedback" />

            <TextView
                android:id="@+id/btnNotReally"
                android:layout_width="128dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_btn_unable_r16"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/tools_result_not_really"
                android:textColor="@color/text_on_tint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnGood"
                android:layout_width="128dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/gradient_red"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/tools_result_good"
                android:textColor="@color/text_on_tint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnCloseFeedback"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:contentDescription="@string/tools_result_close"
                android:focusable="true"
                android:src="@mipmap/ic_close" />

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
