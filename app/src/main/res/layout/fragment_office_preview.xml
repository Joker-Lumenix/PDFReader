<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline Office preview.
  The format specific preview view is added to the content container at runtime,
  the loading and the error state are shown until the document is parsed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/llLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/preview_loading" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_muted"
            android:visibility="gone">

            <com.peng.pdfreader.appcore.widget.EmptyStateView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

    </FrameLayout>

    <!--
      The bottom bar of the design: 74dp tall, four icons on fixed spots.
      Favourite, bookmark, open with and share - the design only labels the
      first, the third and the fourth one.
    -->
    <FrameLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="46dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_favorite"
            android:focusable="true"
            android:src="@mipmap/ic_star_unselect" />

        <ImageView
            android:id="@+id/ivBookmark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="90dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_bookmark"
            android:focusable="true"
            android:src="@mipmap/ic_collect_unselect" />

        <ImageView
            android:id="@+id/ivOpenWith"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="166dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_open_with"
            android:focusable="true"
            android:src="@mipmap/ic_open_with" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="286dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_share"
            android:focusable="true"
            android:src="@mipmap/ic_share_square_black" />

        <TextView
            android:id="@+id/tvFavorite"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_favorite"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- The second action carries no label, the design shows a bare icon. -->

        <TextView
            android:id="@+id/tvOpenWith"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="140dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_open_with"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvShare"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="260dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_share"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </FrameLayout>

</LinearLayout>
