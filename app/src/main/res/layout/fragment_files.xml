<?xml version="1.0" encoding="utf-8"?>
<!--
  Files tab (design: files / files-搜索 / files-Selected / files-Selected more / files空).

  - 64dp title strip below the status bar; in search mode it is covered by the
    search field (the field is pushed below the status bar by the code)
  - 44dp scope row (全部 / 最近 / 收藏) with the search entry on the right;
    the row disappears in the search, selection and empty states
  - the document list (336dp wide cards, 12dp gutters, 12dp row gap)
  - the multi select action bar (80dp) at the bottom, four actions for a single
    selection (分享 / 重命名 / 编辑 / 删除) and three for several (分享 / 合并 / 删除)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.peng.pdfreader.appcore.widget.PageTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- search field, slides over the title strip -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="@color/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_white_r36"
                android:backgroundTint="@null"
                android:hint="@string/files_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                android:textColorHint="@color/text_placeholder"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSearchCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/cancel"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- scope row: 全部 / 最近 / 收藏 + the search entry -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface_muted"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="91"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_tab_all"
                android:textSize="14sp" />

            <View
                android:id="@+id/indTabAll"
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="92"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabRecent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_tab_recent"
                android:textSize="14sp" />

            <View
                android:id="@+id/indTabRecent"
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="88"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_tab_favorites"
                android:textSize="14sp" />

            <View
                android:id="@+id/indTabFavorites"
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/searchSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="89">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/search"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_search_black" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_muted"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <com.peng.pdfreader.appcore.widget.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="114dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- hairline above the multi select action bar -->
    <View
        android:id="@+id/selectBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_hairline"
        android:visibility="gone" />

    <!--
        multi select action bar (design: files-Selected / files-Selected more).

        One selection shows 分享 / 重命名 / 编辑 / 删除, several show
        分享 / 合并 / 删除 - the 编辑 slot is dropped so the three actions
        share the bar evenly.
    -->
    <LinearLayout
        android:id="@+id/selectBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/surface_card"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/actionSelectShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/files_share"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_share_red" />

            <TextView
                android:id="@+id/tvActionSelectShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_share"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectSecond"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectSecond"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/rename"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_rename_black" />

            <TextView
                android:id="@+id/tvActionSelectSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rename"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/files_action_edit"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_edit_black" />

            <TextView
                android:id="@+id/tvActionSelectEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_action_edit"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/delete"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_delete_black" />

            <TextView
                android:id="@+id/tvActionSelectDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/delete"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
