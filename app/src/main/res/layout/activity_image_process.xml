<?xml version="1.0" encoding="utf-8"?>
<!--
  The image processing page of the "image to PDF" flow (designs "img-only1",
  "img-page" and "img-page2").

  Geometry of the design (360x760):
  - app bar 63 high, the back arrow at x=24 and the red pill at x=284
  - the picture 336 wide at x=12, its height follows the picture
  - the pager below the picture: the arrows at x=125 / 216 and the counter
    in the middle
  - the bottom bar 90 high with the three actions of the design
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <!-- 顶部标题栏：返回按钮 + 右上角的完成按钮 -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="20dp"
            android:contentDescription="@string/label_back"
            android:src="@drawable/ic_arrow_back" />

        <!-- the red pill with the check of the design -->
        <ImageView
            android:id="@+id/btnDone"
            android:layout_width="56dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:contentDescription="@string/done"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_done" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- the picture of the design fills the width, its height is set in code -->
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/tools_image_select"
            android:scaleType="fitCenter" />

        <!-- the pager of the design: the arrows and the counter -->
        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPrev"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:clickable="true"
                android:contentDescription="@string/tools_image_previous"
                android:focusable="true"
                android:src="@mipmap/ic_left_arrow_unable" />

            <TextView
                android:id="@+id/tvCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginEnd="21dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="1/3" />

            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:clickable="true"
                android:contentDescription="@string/tools_image_next"
                android:focusable="true"
                android:src="@mipmap/ic_arrow_right_unable" />

        </LinearLayout>

        <!-- the ad slot of the design, between the pager and the bottom bar -->
        <com.peng.pdfreader.core.widget.AdSlotView
            android:id="@+id/adBanner"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp" />

    </FrameLayout>

    <!-- 底部的操作栏：删除 / 左转 / 右转 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/white"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/colDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/delete"
                android:src="@mipmap/ic_delete_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/delete"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/colRotateLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tools_image_rotate_left"
                android:src="@mipmap/ic_anticlockwise" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tools_image_rotate_left"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/colRotateRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tools_image_rotate_right"
                android:src="@mipmap/ic_clockwise" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tools_image_rotate_right"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
