<?xml version="1.0" encoding="utf-8"?>
<!-- Outline (table of contents) of the document. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_r16"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_outline" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/TextAppearance.AppCore.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/no_outline"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="320dp"
        android:overScrollMode="never" />

</LinearLayout>
