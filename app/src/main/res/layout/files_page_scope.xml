<?xml version="1.0" encoding="utf-8"?>
<!--
  One page of the files tab.

  The tabs 全部 / 最近 / 收藏 are pages of a pager, every page carries its own
  list and its own empty state.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_muted"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none" />

    <com.peng.pdfreader.core.widget.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="114dp"
        android:visibility="gone" />

</FrameLayout>
