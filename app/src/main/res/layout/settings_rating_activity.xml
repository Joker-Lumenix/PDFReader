<?xml version="1.0" encoding="utf-8"?>
<!--
  Rating sheet of the design: the illustration peeks over the top edge of a
  332dp white sheet, the question, the "top rating" bubble, five stars and the
  action button.

  The sheet is anchored to the bottom of the screen, the illustration 319dp
  above the bottom edge so that it ends 13dp behind the top of the sheet.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_75"
        android:clickable="true"
        android:focusable="true" />

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="360dp"
        android:layout_height="196dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="319dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@mipmap/bg_rate" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="332dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet_top_r16">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="41dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_on_night_accent_alt"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Do you like Let's PDF?" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/rating_hint"
            android:textColor="@color/text_placeholder"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvBubble"
            android:layout_width="143dp"
            android:layout_height="43dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:background="@mipmap/ic_chat_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/rating_top_rating"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <FrameLayout
            android:id="@+id/llStars"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginTop="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBubble">

            <!-- The two halos behind the fifth star are drawn in code. -->
            <View
                android:id="@+id/vStarHalo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="29dp" />

            <View
                android:id="@+id/vStarCore"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="41dp" />

            <LinearLayout
                android:id="@+id/llStarRow"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivStar1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="22dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_star_unselect" />

                <ImageView
                    android:id="@+id/ivStar2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="22dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_star_unselect" />

                <ImageView
                    android:id="@+id/ivStar3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="22dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_star_unselect" />

                <ImageView
                    android:id="@+id/ivStar4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="22dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_star_unselect" />

                <ImageView
                    android:id="@+id/ivStar5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_star_unselect" />
            </LinearLayout>
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_btn_unable_r16"
            android:backgroundTint="@null"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="@string/rate"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
