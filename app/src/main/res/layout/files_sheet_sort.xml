<?xml version="1.0" encoding="utf-8"?>
<!--
  Sort sheet (design: files-选择).

  Three sections, every option lives in a card and carries a radio on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/files_sort_title" />

    <!-- ======================= last modified ======================= -->
    <TextView
        style="@style/TextAppearance.AppCore.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="@string/files_sort_section_time" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card_r8"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowModified"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_card_r4"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_new_to_old" />

            <TextView
                android:id="@+id/tvModified"
                style="@style/TextAppearance.AppCore.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sort_modified"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/radioModified"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_checkbox_circle_unselect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCreated"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_card_r4"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_new_to_old" />

            <TextView
                android:id="@+id/tvCreated"
                style="@style/TextAppearance.AppCore.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sort_created"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/radioCreated"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_checkbox_circle_unselect" />
        </LinearLayout>
    </LinearLayout>

    <!-- =========================== name =========================== -->
    <TextView
        style="@style/TextAppearance.AppCore.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="@string/files_sort_section_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card_r8"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_card_r4"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_az" />

            <TextView
                android:id="@+id/tvName"
                style="@style/TextAppearance.AppCore.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sort_name"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/radioName"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_checkbox_circle_unselect" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================= file size ========================= -->
    <TextView
        style="@style/TextAppearance.AppCore.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:text="@string/files_sort_section_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card_r8"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowSize"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_card_r4"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_size" />

            <TextView
                android:id="@+id/tvSize"
                style="@style/TextAppearance.AppCore.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/sort_size"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/radioSize"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_checkbox_circle_unselect" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
