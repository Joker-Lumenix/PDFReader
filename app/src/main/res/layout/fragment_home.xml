<?xml version="1.0" encoding="utf-8"?>
<!--
  Home tab.
  Quick action cards + type filter strip + document list + scan button.
  The bottom navigation is owned by the shell, so it is not part of this page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <!-- 标题 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        >

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            tools:text="let's PDF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginLeft="20dp"
            />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_search_red"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="100dp"
            />

        <ImageView
            android:id="@+id/ivFileSelect"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_file_choose"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="60dp"
            />

        <ImageView
            android:id="@+id/ivSort"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_sort"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        >

        <LinearLayout
            android:id="@+id/toolsImageToPdf"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_r8"
            android:layout_marginLeft="12dp"
            >
            
            <ImageView
                android:layout_width="80dp"
                android:layout_height="44dp"
                android:src="@mipmap/ic_tools_image_to_pdf"
                android:layout_marginTop="8dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_to_pdf"
                android:layout_marginTop="4dp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolsMergePdf"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_r8"
            android:layout_marginLeft="12dp"
            >

            <ImageView
                android:layout_width="80dp"
                android:layout_height="44dp"
                android:src="@mipmap/ic_tools_merge_pdf"
                android:layout_marginTop="8dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/merge_to_pdf"
                android:layout_marginTop="4dp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/toTools"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_r8"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"
            >

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/ic_go_to_setting"
                android:layout_marginTop="8dp"
                />

        </LinearLayout>
    </LinearLayout>

    <!--
      文件类型筛选条: 全部 / PDF / Word / Excel / PPT。
      条目的几何属性都在这个自定义View里面, 见 FilterStripView 的注释。
    -->
    <com.peng.pdfreader.core.widget.FilterStripView
        android:id="@+id/filterStrip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:filterIndicatorColor="@color/brand_primary"
        app:filterIndicatorGap="12dp"
        app:filterIndicatorHeight="2dp"
        app:filterIndicatorRadius="1dp"
        app:filterIndicatorWidth="44dp"
        app:filterItemHeight="44dp"
        app:filterLabelTextSize="14sp"
        app:filterSelectedColor="@color/brand_primary"
        app:filterUnselectedColor="@color/text_disabled" />

    <!-- one page per file type, swiped horizontally -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/documentPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
