<?xml version="1.0" encoding="utf-8"?>
<!--
  Home tab.
  Quick action cards + type filter strip + document list + scan button.
  The bottom navigation is owned by the shell, so it is not part of this page.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <!-- The bar covers the status bar as well, so it carries the card surface. -->
    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card" />

    <!--
      quick action cards, the row is wider than the screen so it scrolls.
      The bar of the shared title bar is 89 tall (24 status + 64 + 1 hairline),
      the cards of the design start at y=99.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="11dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:scrollbars="none" />

    <!-- file type filter strip: All / PDF / Word / Excel / PPT -->
    <LinearLayout
        android:id="@+id/filterStrip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/filterAll"
            layout="@layout/home_item_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/filterPdf"
            layout="@layout/home_item_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/filterWord"
            layout="@layout/home_item_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/filterExcel"
            layout="@layout/home_item_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/filterPpt"
            layout="@layout/home_item_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- one page per file type, swiped horizontally -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/documentPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/fabScan"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:clickable="true"
            android:contentDescription="@string/home_scan"
            android:focusable="true"
            android:src="@mipmap/ic_google_scan" />

    </FrameLayout>

</LinearLayout>
