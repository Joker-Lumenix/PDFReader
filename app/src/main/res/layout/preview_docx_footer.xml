<?xml version="1.0" encoding="utf-8"?>
<!--
  The marker at the end of the pages of a document.

  The pages of a big document are laid out one after the other, the marker
  shows the reader that the document goes on behind it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <ProgressBar
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tvLoading"
        style="@style/TextAppearance.AppCore.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_tertiary" />

</LinearLayout>
