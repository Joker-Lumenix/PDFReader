<?xml version="1.0" encoding="utf-8"?>
<!--
  The progress page of the tool flows.

  Every tool - image to pdf, merge, split, compress, scan - opens this page
  while it builds a document. The page shows the progress of the job and hands
  the result over to the result page when the job is done.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/progressView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        layout="@layout/tools_view_progress" />

</LinearLayout>
