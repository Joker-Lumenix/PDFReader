<?xml version="1.0" encoding="utf-8"?><!--
  The progress page of the tool flows.

  Every tool - image to pdf, merge, split, compress, scan - opens this page
  while it builds a document. The page shows the progress of the job and hands
  the result over to the result page when the job is done.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <!-- 顶部标题栏：运行中的任务没有返回按钮，标题也是空的 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/label_back"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.AppCore.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 标题栏下方的细线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_hairline" />

    <FrameLayout
        android:id="@+id/progressView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false" >

        <View
            android:id="@+id/progressCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_r8" />

        <ImageView
            android:id="@+id/ivProgressArt"
            android:layout_width="127dp"
            android:layout_height="162dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="88dp"
            android:contentDescription="@null"
            android:src="@mipmap/bg_deal_progress" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="278dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/brand_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvProgressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="304dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- the progress track of the design: 240x6 with a handle -->
        <FrameLayout
            android:id="@+id/progressHolder"
            android:layout_width="240dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="354dp"
            android:clipChildren="false">

            <View
                android:id="@+id/progressTrack"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="center"
                />

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_gravity="start|center_vertical" />

            <ImageView
                android:id="@+id/progressKnob"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@null"
                android:src="@mipmap/emoji_normal" />

        </FrameLayout>

        <!-- the ad slot of the design, below the progress of the job -->
        <com.peng.pdfreader.core.widget.AdSlotView
            android:id="@+id/adSlot"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="12dp" />

    </FrameLayout>

</LinearLayout>
