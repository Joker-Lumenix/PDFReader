<?xml version="1.0" encoding="utf-8"?>
<!--
  File selection page (design: files-Selected).

  The title bar carries the back arrow, the number of the picked files and the
  type filter on the right hand side. The list shows the checkboxes, the action
  bar at the bottom offers 分享 / 重命名 / 编辑 / 删除 for a single selection and
  分享 / 合并 / 删除 for several.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <RelativeLayout android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        >

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/label_back"
            android:src="@drawable/ic_arrow_back"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/tvTitle"
            android:textSize="15sp"
            android:textColor="#ff060606"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:maxWidth="150dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/ivBack"
            android:ellipsize="end"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:layout_marginStart="7dp"
            tools:text="标题"
            />

        <ImageView
            android:id="@+id/ivChooseAll"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_square_red"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_muted"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <com.peng.pdfreader.core.widget.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="114dp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/selectBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_hairline" />

    <LinearLayout
        android:id="@+id/selectBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/surface_card"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/actionSelectShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/files_share"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_share_square_black" />

            <TextView
                android:id="@+id/tvActionSelectShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_share"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectSecond"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectSecond"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/rename"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_rename_black" />

            <TextView
                android:id="@+id/tvActionSelectSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rename"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/files_action_edit"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_edit_black" />

            <TextView
                android:id="@+id/tvActionSelectEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/files_action_edit"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionSelectDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <ImageView
                android:id="@+id/ivActionSelectDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/delete"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_delete_black" />

            <TextView
                android:id="@+id/tvActionSelectDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/delete"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
