<?xml version="1.0" encoding="utf-8"?>
<!--
  The search of a document: the field for the word and the list of the pages
  that hold it. It follows the outline sheet, so both look the same.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_r16"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_search" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            style="@style/Widget.AppCore.InputField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:hint="@string/preview_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvSearch"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/preview_search_action" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/TextAppearance.AppCore.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/preview_search_empty"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="320dp"
        android:overScrollMode="never" />

</LinearLayout>
