<?xml version="1.0" encoding="utf-8"?>
<!--
  The quick actions of the ongoing notification of the design.

  The row is 72dp tall and carries the four entries of the design: a 28x28 icon
  on top and the label of the action below it. The labels are 10sp and use the
  #333333 of the design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/surface_card"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/quickPrint"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQuickPrint"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_notification_action"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:tint="#ffffff"
            android:src="@mipmap/ic_print" />

        <TextView
            android:id="@+id/tvQuickPrint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            tools:text="Print PDF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickScan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQuickScan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_notification_action"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:tint="#ffffff"
            android:src="@mipmap/ic_camera" />

        <TextView
            android:id="@+id/tvQuickScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            tools:text="Scan PDF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickLock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQuickLock"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_notification_action"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:tint="#ffffff"
            android:src="@mipmap/ic_lock" />

        <TextView
            android:id="@+id/tvQuickLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            tools:text="Lock PDF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickCompress"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQuickCompress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_notification_action"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:tint="#ffffff"
            android:src="@mipmap/ic_compress" />

        <TextView
            android:id="@+id/tvQuickCompress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            tools:text="Compress" />
    </LinearLayout>

</LinearLayout>
