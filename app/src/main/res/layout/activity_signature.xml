<?xml version="1.0" encoding="utf-8"?>
<!--
  Signature editor.
  Top bar: back, undo, redo and the confirm pill.
  Content: the signing canvas and the floating colour palette.
  Bottom: the colour bar of the design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_blue_tint"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height_editor"
            android:background="@color/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/preview_cd_close"
                android:src="@mipmap/ic_close" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivUndo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/preview_cd_undo"
                android:src="@mipmap/ic_undo_unable" />

            <ImageView
                android:id="@+id/ivRedo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/preview_cd_redo"
                android:src="@mipmap/ic_restore_unable" />

            <FrameLayout
                android:id="@+id/flDone"
                android:layout_width="55dp"
                android:layout_height="24dp"
                android:background="@drawable/gradient_red"
                android:clickable="true"
                android:contentDescription="@string/preview_cd_done"
                android:focusable="true">

                <com.peng.pdfreader.core.widget.CheckMarkView
                    android:id="@+id/ivDone"
                    android:layout_width="15dp"
                    android:layout_height="10dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_hairline" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.peng.pdfreader.core.widget.SignatureCanvasView
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          The floating palette of the design: the dark panel with the pointer
          that shows the colour of the bar below. The swatches start eleven
          pixels inside the panel and the last one runs past the edge of the
          screen, exactly as in the design.
        -->
        <LinearLayout
            android:id="@+id/llPalette"
            android:layout_width="331dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="17dp"
            android:background="@mipmap/bg_color_choose"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="0dp"
            android:visibility="gone">

            <com.peng.pdfreader.core.widget.ColorPaletteView
                android:id="@+id/palette"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp">

        <TextView
            android:id="@+id/tvColorLabel"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/preview_color"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- The colour of the next stroke, a 10dp dot inside a 14dp ring. -->
        <com.peng.pdfreader.core.widget.ColorPaletteView
            android:id="@+id/swatch"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_color"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
