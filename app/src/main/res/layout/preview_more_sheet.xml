<?xml version="1.0" encoding="utf-8"?>
<!--
  The overflow menu of the reader.
  Header: the logo, the name and the meta line of the file.
  Tiles: the four actions of the design.
  Wide row: the secondary action.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_r16"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/TextAppearance.AppCore.SheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvType"
                    style="@style/TextAppearance.AppCore.TypeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_type_chip"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_success" />

                <TextView
                    android:id="@+id/tvMeta"
                    style="@style/TextAppearance.AppCore.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The four action tiles, on the spots of the design: 40 / 123 / 206 / 289. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="32dp">

        <ImageView
            android:id="@+id/ivTile0"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/ivTile1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="123dp"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/ivTile2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="206dp"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/ivTile3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="289dp"
            android:background="@drawable/bg_icon_tile"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvTile0"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="18dp"
            android:layout_marginTop="40dp"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTile1"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="101dp"
            android:layout_marginTop="40dp"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTile2"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="184dp"
            android:layout_marginTop="40dp"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTile3"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="267dp"
            android:layout_marginTop="40dp"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- The wide action of the design: 320 x 48, #f5f5f5, 6.4dp radius. -->
    <LinearLayout
        android:id="@+id/llWide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ivWide"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvWide"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
