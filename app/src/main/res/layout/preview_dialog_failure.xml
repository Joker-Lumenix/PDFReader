<?xml version="1.0" encoding="utf-8"?>
<!--
  The failure dialog of the preview (design: 失败).

  The illustration (160x133) sits above the card and overlaps it, the card
  (328x131, radius 20) carries the message and the confirm button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="160dp"
        android:layout_height="133dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@mipmap/bg_load_fail" />

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="111dp"
        android:background="@drawable/bg_card_r20"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/gradient_red"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

</FrameLayout>
