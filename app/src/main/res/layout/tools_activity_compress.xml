<?xml version="1.0" encoding="utf-8"?>
<!--
  Compress flow (design "压缩结果页").

  Step one lists the PDF documents of the sandbox, step two shows the result
  page with the size comparison.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDocuments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none" />

        <include
            android:id="@+id/resultPage"
            layout="@layout/tools_result_body" />

    </FrameLayout>

</LinearLayout>
