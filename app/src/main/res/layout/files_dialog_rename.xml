<?xml version="1.0" encoding="utf-8"?>
<!--
  Rename sheet (design: home-PDF-rename).

  Title, the name field and the cancel / ok pair; the sheet sits directly above
  the keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/rename" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp">

        <EditText
            android:id="@+id/etName"
            style="@style/Widget.AppCore.InputField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_edit_r12"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="36dp"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:contentDescription="@string/cancel"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_close" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_unable_r16"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/cancel" />

        <Space
            android:layout_width="34dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/ok" />
    </LinearLayout>

</LinearLayout>
