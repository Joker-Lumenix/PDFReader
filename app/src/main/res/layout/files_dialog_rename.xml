<?xml version="1.0" encoding="utf-8"?>
<!--
  Rename dialog.

  The input carries the current file name, the confirm button writes the new
  name back into the document sandbox.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/rename" />

    <EditText
        android:id="@+id/etName"
        style="@style/Widget.AppCore.InputField"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:hint="@string/files_rename_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_unable_r16"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/cancel" />

        <Space
            android:layout_width="22dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ok" />
    </LinearLayout>

</LinearLayout>
