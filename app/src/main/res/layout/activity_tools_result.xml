<?xml version="1.0" encoding="utf-8"?>
<!--
  The result page of the tool flows (designs "Merged Successfully!" and
  "压缩结果页").

  The page is shared by every tool: the title bar carries the name of the page,
  the body shows the produced document, the size comparison or the success
  title. Which of them is on the screen is decided by the parameters of the
  intent, not by the tool that opened the page.

  The body scrolls, the feedback card floats over it - the card of the design
  sits at the bottom of the page and does not move with the content.

  Geometry of the design (360x760):
  - hero 336x100 at (12, 93)
  - file card 336x174 at (12, 193), only the bottom corners are rounded
  - more card 336x204 at (12, 375)
  - feedback card 336x118 floating at the bottom
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏：返回按钮 + 标题 -->
        <LinearLayout android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:background="@color/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.AppCore.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 标题栏下方的细线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_hairline" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/resultScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- ==================== hero ==================== -->

                <FrameLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:id="@+id/ivHero"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:contentDescription="@string/tools_result_view"
                        android:layout_marginHorizontal="12dp"
                        android:scaleType="fitXY"
                        android:src="@mipmap/bg_result" />

                    <!-- merge variant, the title sits in the light band of the artwork -->
                    <LinearLayout
                        android:id="@+id/heroSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="60dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:textColor="@color/status_success"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivHeroMark"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/merged_success"
                            android:src="@mipmap/ic_ok" />

                    </LinearLayout>

                    <!-- compress variant, the two size chips of the design -->
                    <LinearLayout
                        android:id="@+id/heroStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="44dp"
                        android:layout_marginEnd="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/chipBefore"
                            android:layout_width="70dp"
                            android:layout_height="46dp"
                            android:background="@color/surface_card"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvSizeBefore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/status_warning"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBeforePill"
                                android:layout_width="54dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/before"
                            android:src="@mipmap/ic_size_arrow" />

                        <LinearLayout
                            android:id="@+id/chipAfter"
                            android:layout_width="70dp"
                            android:layout_height="46dp"
                            android:background="@color/surface_card"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvSizeAfter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/status_info_blue6"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAfterPill"
                                android:layout_width="54dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- ==================== produced document ==================== -->

                <FrameLayout
                    android:id="@+id/fileCard"
                    android:layout_width="match_parent"
                    android:layout_height="174dp"
                    android:background="@drawable/bg_card_r8"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="62dp"
                        android:layout_height="82dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="16dp"
                        android:contentDescription="@string/tools_result_view"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tvPageBadge"
                        android:layout_width="28dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="82dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvFileName"
                        style="@style/TextAppearance.AppCore.ItemTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="86dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="40dp"
                        android:ellipsize="end"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/tvFilePath"
                        style="@style/TextAppearance.AppCore.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="86dp"
                        android:layout_marginTop="58dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="middle"
                        android:maxLines="2" />

                    <ImageView
                        android:id="@+id/btnRename"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/rename_file"
                        android:src="@mipmap/ic_rename_black" />

                    <TextView
                        android:id="@+id/btnShare"
                        android:layout_width="145dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_btn_unable_r16"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/tools_result_share"
                        android:textColor="@color/text_on_tint"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnView"
                        android:layout_width="145dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/gradient_red"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/tools_result_view"
                        android:textColor="@color/text_on_tint"
                        android:textSize="12sp" />

                </FrameLayout>

                <!-- ==================== more actions ==================== -->

                <LinearLayout
                    android:id="@+id/moreCard"
                    android:layout_width="match_parent"
                    android:layout_height="204dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_card_r8"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/tvMoreTitle"
                        style="@style/TextAppearance.AppCore.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/tools_result_more" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cellOpenWith"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_open_with"
                                android:src="@mipmap/ic_open_with" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_open_with"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cellPrint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_print"
                                android:src="@mipmap/ic_print" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_print"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cellDraw"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_draw"
                                android:src="@mipmap/ic_draw_red" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_draw"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cellCompress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_compress"
                                android:src="@mipmap/ic_compress" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_compress"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cellSign"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_sign"
                                android:src="@mipmap/ic_sign_red" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_sign"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cellLock"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_icon_tile"
                                android:contentDescription="@string/tools_result_lock"
                                android:src="@mipmap/ic_lock" />

                            <TextView
                                style="@style/TextAppearance.AppCore.Meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="@string/tools_result_lock"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!--
                  The room the floating feedback card needs, so the content
                  can be scrolled completely out of its way.
                -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="142dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!--
      ==================== feedback ====================

      The card of the design floats over the content: the content scrolls
      behind it, the card stays where it is.
    -->
    <FrameLayout
        android:id="@+id/feedbackCard"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_r8">

        <TextView
            android:id="@+id/tvFeedback"
            style="@style/TextAppearance.AppCore.ItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:maxLines="2"
            android:text="@string/tools_result_feedback" />

        <LinearLayout
            android:id="@+id/btnNotReally"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_unable_r16"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/tools_result_not_really"
                android:src="@mipmap/emoji_cry" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tools_result_not_really"
                android:textColor="@color/text_on_tint"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnGood"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/tools_result_good"
                android:src="@mipmap/emoji_laugh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tools_result_good"
                android:textColor="@color/text_on_tint"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseFeedback"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:contentDescription="@string/tools_result_close"
            android:focusable="true"
            android:src="@mipmap/ic_close" />

    </FrameLayout>

</FrameLayout>
