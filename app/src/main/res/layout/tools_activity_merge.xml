<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge flow (designs "merge-1", "merge-2", "merging", "Merged Successfully!").

  The activity carries the four steps of the flow:
  stepSelect  - the multi select of the documents to merge (merge-1)
  stepOrder   - the ordered list of the picked documents (merge-2)
  stepProgress- the running job (merging)
  resultPage  - the produced document (Merged Successfully!)

  The primary action floats above the list, the design shows the list running
  below the button, so the bottom bar is an overlay of the content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.peng.pdfreader.appcore.widget.PageTitleBar
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- merge-1: the documents of the sandbox, 336x72 rows at x=12 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <!-- merge-2: the ordered documents, the row carries the remove button -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <!-- merging: the running job inside its own card -->
            <FrameLayout
                android:id="@+id/stepProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <View
                    android:id="@+id/progressCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_r8" />

                <ImageView
                    android:id="@+id/ivProgressArt"
                    android:layout_width="127dp"
                    android:layout_height="162dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="88dp"
                    android:contentDescription="@string/tools_merge_running"
                    android:src="@mipmap/bg_deal_progress" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="278dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/brand_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="304dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- the progress track of the design: 240x6 with a handle -->
                <FrameLayout
                    android:id="@+id/progressHolder"
                    android:layout_width="240dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="354dp">

                    <View
                        android:id="@+id/progressTrack"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_gravity="center" />

                    <View
                        android:id="@+id/progressFill"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_gravity="start|center_vertical" />

                    <ImageView
                        android:id="@+id/progressKnob"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="start|center_vertical"
                        android:contentDescription="@string/tools_merge_running" />

                </FrameLayout>

            </FrameLayout>

            <include
                android:id="@+id/resultPage"
                layout="@layout/tools_result_body" />

        </FrameLayout>

    </LinearLayout>

    <!-- the primary action of the design: 312x48 at x=24, radius 16 -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp" />

    </FrameLayout>

</FrameLayout>
