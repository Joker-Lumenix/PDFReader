<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge flow (designs "merge-1", "merge-2", "merging", "Merged Successfully!").

  The activity carries the four steps of the flow:
  stepSelect  - the multi select of the documents to merge (merge-1)
  stepOrder   - the ordered list of the picked documents (merge-2)
  stepProgress- the running job (merging)
  resultPage  - the produced document (Merged Successfully!)

  The primary action floats above the list, the design shows the list running
  below the button, so the bottom bar is an overlay of the content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏：返回按钮 + 标题 + 右侧的两个操作 -->
        <LinearLayout android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:background="@color/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/label_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.AppCore.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/share"
                android:src="@mipmap/ic_share_app" />

            <ImageView
                android:id="@+id/ivAdd"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tools_merge_add"
                android:src="@mipmap/ic_add_circle" />
        </LinearLayout>

        <!-- 标题栏下方的细线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_hairline" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- merge-1: the documents of the sandbox, 336x72 rows at x=12 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <!-- merge-2: the ordered documents, the row carries the remove button -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="96dp"
                android:scrollbars="none" />

            <!--
              The running job and the result have their own pages: the shared
              progress page and the shared result page.
            -->

        </FrameLayout>

    </LinearLayout>

    <!-- the primary action of the design: 312x48 at x=24, radius 16 -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp" />

    </FrameLayout>

</FrameLayout>
