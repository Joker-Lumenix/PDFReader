<?xml version="1.0" encoding="utf-8"?>
<!--
  File picker of the lock / unlock flow (design "lock PDF").

  The page shows the PDF files of the sandbox. The button in the top right
  corner searches in the list, the field of the search takes the place of the
  title. The rows carry no action of their own - the whole row picks the file.

  Layout per design: app bar 87dp (#fafafa), the file cards are 336x72 with a
  12dp gutter (x=12), the first card starts 12dp below the app bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <!-- 顶部标题栏：返回按钮 + 标题 + 右侧的搜索 -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/label_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.AppCore.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- 搜索状态：搜索框占住标题的位置，取消按钮在它的右边 -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_white_r36"
            android:backgroundTint="@null"
            android:hint="@string/tools_merge_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_secondary"
            android:textColorHint="@color/text_placeholder"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSearchCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- the search button of the design -->
        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:contentDescription="@string/tools_merge_search"
            android:focusable="true"
            android:src="@mipmap/ic_search_black" />

    </LinearLayout>

    <!-- 标题栏下方的细线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_hairline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <com.peng.pdfreader.core.widget.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="138dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
