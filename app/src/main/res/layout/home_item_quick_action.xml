<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick action card (133x82): 80x44 artwork + 12sp / 500 label.
  The artwork already carries the PDF badge of the tool, see ic_tools_*.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="133dp"
    android:layout_height="82dp"
    android:background="@drawable/bg_card_r8"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <ImageView
        android:id="@+id/quickIcon"
        android:layout_width="80dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_tools_image_to_pdf" />

    <TextView
        android:id="@+id/quickLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
