<?xml version="1.0" encoding="utf-8"?>
<!--
  Language selection page: title bar with a back arrow, the list card
  (336x649dp, 12dp below the bar) and the "Next" button that stays disabled
  until a language has been picked. The button overlaps the lower edge of the
  card, exactly like the design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:orientation="vertical">

    <!-- 顶部标题栏：返回按钮 + 标题 -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/label_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.AppCore.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 标题栏下方的细线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_hairline" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLanguages"
            android:layout_width="0dp"
            android:layout_height="649dp"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginTop="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:background="@drawable/bg_card_r8"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:itemCount="4"
            tools:listitem="@layout/language_row" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="@dimen/space_xxl"
            android:background="@drawable/bg_btn_unable_r16"
            android:backgroundTint="@null"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="@string/next"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
