<?xml version="1.0" encoding="utf-8"?>
<!--
  Split flow (designs "Split PDF", "Split PDF2", "Split PDF-rename").

  The blue banner sits right below the app bar, the page grid fills the rest
  of the screen and the primary action stays at the bottom.

  Geometry of the design (360x760):
  - banner 336x30 at (12, 92), radius 8, #6d99f9
  - page tiles 104x124 at x = 12 / 128 / 244, rows at y = 134 / 270
  - primary action 312x48 at (24, 680), radius 16
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/stepPages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- the info banner of the design, its content is centred -->
            <LinearLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/bannerIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/tools_split_reorder" />

                <TextView
                    android:id="@+id/bannerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/select_page_hint"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="12dp"
                android:scrollbars="none" />

        </LinearLayout>

        <com.peng.pdfreader.appcore.widget.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top" />

        <include
            android:id="@+id/resultPage"
            layout="@layout/tools_result_body" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnSplit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/tools_split_action"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp" />

    </FrameLayout>

</LinearLayout>
