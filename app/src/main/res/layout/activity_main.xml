<?xml version="1.0" encoding="utf-8"?>
<!--
  Application shell: a fragment container plus the four tab bottom navigation.
  Every tab is an independent fragment, the shell only swaps them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.peng.pdfreader.appcore.widget.BottomNavBar
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
