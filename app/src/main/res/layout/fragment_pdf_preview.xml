<?xml version="1.0" encoding="utf-8"?>
<!--
  PDF reader.
  Top bar: back arrow, document name, rename action and the overflow.
  Content: the pages, the annotation tool bar and the page indicator.
  Bottom: the four actions of the design (favourite, annotate, open with, share).
  The icons sit on the exact positions of the design: 46 / 90 / 166 / 286.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/surface_blue_tint"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        >

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="20dp"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/appcore_back"
            android:src="@drawable/ic_arrow_back"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/tvTitle"
            android:textSize="15sp"
            android:textColor="#ff060606"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:maxWidth="150dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/ivBack"
            android:ellipsize="end"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:layout_marginStart="7dp"
            tools:text="标题"
            />

        <TextView
            android:id="@+id/tvL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="("
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tvTitle"
            android:textColor="#ff060606"
            android:layout_marginLeft="7dp"
            />

        <TextView
            android:id="@+id/tvPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tvL"
            android:textColor="#ff060606"
            tools:text="2/90"
            />

        <TextView
            android:id="@+id/tvR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=")"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tvPageIndicator"
            android:textColor="#ff060606"
            />

        <ImageView
            android:id="@+id/ivRename"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_rename_black"
            android:layout_toEndOf="@+id/tvPageIndicator"
            android:layout_centerVertical="true"
            android:layout_marginStart="7dp"
            />

        <ImageView
            android:id="@+id/ivMore"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_more"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <LinearLayout
            android:id="@+id/addBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAdd"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/preview_cd_add_signature" />

            <TextView
                android:id="@+id/tvAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/preview_add_signature"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!--
      The annotation tools of the reader: highlight, underline, strike through,
      free hand, note and signature. The signature and the free hand follow the
      design of the bottom bar, the underline and the other marks are the tools
      of the strip.
    -->
    <include
        android:id="@+id/annotationToolbar"
        layout="@layout/preview_annotation_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The bottom bar of the design: 74dp tall, four icons on fixed spots. -->

    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:orientation="horizontal"
        android:background="@color/white"
        >

        <LinearLayout
            android:id="@+id/llShare"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="15dp"
                android:src="@mipmap/ic_share_square_black" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="@string/files_share"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llDraw"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="15dp"
                android:src="@mipmap/ic_draw" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="@string/tools_result_draw"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llSign"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="15dp"
                android:src="@mipmap/ic_sign" />

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="@string/preview_tool_signature"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
