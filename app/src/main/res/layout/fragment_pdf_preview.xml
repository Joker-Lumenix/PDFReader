<?xml version="1.0" encoding="utf-8"?>
<!--
  PDF reader.
  Top bar: back arrow, document name, rename action and the overflow.
  Content: the pages, the annotation tool bar and the page indicator.
  Bottom: the four actions of the design (favourite, annotate, open with, share).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_blue_tint"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <include
                android:id="@+id/annotationBar"
                layout="@layout/preview_annotation_toolbar" />

            <TextView
                android:id="@+id/tvPageIndicator"
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_white_r36"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/actionFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/preview_cd_favorite"
                android:src="@mipmap/ic_star_unselect" />

            <TextView
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_favorite"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionAnnotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivAnnotate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/preview_cd_annotate"
                android:src="@mipmap/ic_draw" />

            <TextView
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_annotate"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/actionOpenWith"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivOpenWith"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/preview_cd_open_with"
                android:src="@mipmap/ic_open_with" />

            <TextView
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_open_with"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/preview_cd_share"
                android:src="@mipmap/ic_share_red" />

            <TextView
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_share"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
