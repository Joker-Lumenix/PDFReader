<?xml version="1.0" encoding="utf-8"?>
<!--
  PDF reader.
  Top bar: back arrow, document name, rename action and the overflow.
  Content: the pages, the annotation tool bar and the page indicator.
  Bottom: the four actions of the design (favourite, annotate, open with, share).
  The icons sit on the exact positions of the design: 46 / 90 / 166 / 286.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_blue_tint"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <include
                android:id="@+id/annotationBar"
                layout="@layout/preview_annotation_toolbar" />

            <TextView
                android:id="@+id/tvPageIndicator"
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_white_r36"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <!--
          The confirmation bar of the design: it shows up when a signature
          waits on the page and adds it to the document.
        -->
        <LinearLayout
            android:id="@+id/addBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAdd"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/preview_cd_add_signature" />

            <TextView
                android:id="@+id/tvAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/preview_add_signature"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- The bottom bar of the design: 74dp tall, four icons on fixed spots. -->
    <FrameLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="46dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_favorite"
            android:focusable="true"
            android:src="@mipmap/ic_star_unselect" />

        <ImageView
            android:id="@+id/ivAnnotate"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="90dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_annotate"
            android:focusable="true"
            android:src="@mipmap/ic_draw" />

        <ImageView
            android:id="@+id/ivOpenWith"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="166dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_open_with"
            android:focusable="true"
            android:src="@mipmap/ic_open_with" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="286dp"
            android:layout_marginTop="15dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/preview_cd_share"
            android:focusable="true"
            android:src="@mipmap/ic_share_square_black" />

        <!-- The annotate action carries no label, the design shows a bare icon -->
        <TextView
            android:id="@+id/tvFavorite"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_favorite"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- The annotate action carries no label, the design shows a bare icon -->

        <TextView
            android:id="@+id/tvOpenWith"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="140dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_open_with"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvShare"
            style="@style/TextAppearance.AppCore.Meta"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="260dp"
            android:layout_marginTop="47dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:text="@string/preview_share"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </FrameLayout>

</LinearLayout>
