<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry of the quick entry popup: the icon on the left, the label and the
  drag handle on the right.

  Geometry of the design: the icon 8dp from the left edge, the label 36dp
  from the left edge and the handle 8dp from the right edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/ivItemIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        tools:src="@mipmap/ic_google_scan" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/text_on_night_accent_alt"
        android:textSize="12sp"
        tools:text="Scan PDF" />

    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/surface_neutral_warm" />

</LinearLayout>
