<?xml version="1.0" encoding="utf-8"?>
<!--
  Result of a successful lock / unlock.

  Layout per design (Moonvy "lock成功" / "unlock成功"):
  the celebration illustration at y=93, the card surface from y=116 with a
  16dp top radius, the status line at y=154, the file row at y=209 and the
  two actions at y=315.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted">

    <!-- card surface, the illustration overlaps its upper left corner -->
    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="251dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="29dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="93dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="62dp"
                android:layout_height="82dp"
                android:contentDescription="@string/result"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/TextAppearance.AppCore.ItemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:ellipsize="end"
                    android:gravity="top"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvPath"
                    style="@style/TextAppearance.AppCore.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:gravity="top"
                    android:maxLines="2" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivDocAction"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/view"
                android:src="@mipmap/ic_open_with" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_unable_r16"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/share"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnView"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:background="@drawable/gradient_red"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/view"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/result"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_result" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="89dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="219dp"
        android:layout_marginTop="67dp"
        android:fontFamily="sans-serif-black"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/status_success"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/ivStatusIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="312dp"
        android:layout_marginTop="66dp"
        android:contentDescription="@string/result"
        android:src="@mipmap/ic_ok" />

</FrameLayout>

