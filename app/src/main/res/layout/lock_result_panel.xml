<?xml version="1.0" encoding="utf-8"?>
<!--
  Result of a successful lock / unlock.

  Layout per design (Moonvy "lock成功" / "unlock成功"): the celebration
  illustration, then a card with the file, its path and the two actions.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="336dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/result"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_result" />

    <LinearLayout
        android:layout_width="336dp"
        android:layout_height="174dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_r8"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/lock_page_encrypt"
                android:src="@mipmap/logo_pdf" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/TextAppearance.AppCore.ItemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvPath"
                    style="@style/TextAppearance.AppCore.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:maxLines="2" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_unable_r16"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/share"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnView"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:background="@drawable/gradient_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/view"
                android:textColor="@color/text_on_tint"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
