<?xml version="1.0" encoding="utf-8"?>
<!--
  Type filter popover (design: files-筛选).

  A 125dp wide card that drops below the title bar and lists the file types
  with the number of documents behind them; the active type carries the radio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="125dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_r8"
    android:orientation="vertical"
    android:paddingStart="17dp"
    android:paddingTop="12dp"
    android:paddingEnd="11dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/rowAll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/radioAll"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_checkbox_circle_unselect" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPdf"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/radioPdf"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_checkbox_circle_unselect" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowWord"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/radioWord"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_checkbox_circle_unselect" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowExcel"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/radioExcel"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_checkbox_circle_unselect" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowPpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPpt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/radioPpt"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_checkbox_circle_unselect" />
    </LinearLayout>

</LinearLayout>
