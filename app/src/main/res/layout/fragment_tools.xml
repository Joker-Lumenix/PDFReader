<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <!-- 顶部标题栏：标题（状态栏的 inset 加在标题栏上，所以状态栏和标题栏同色） -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:background="@color/surface_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingLeft="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tools"
            android:textColor="#ff060606"
            android:textSize="20sp"
            android:textStyle="bold"
            />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/adBanner"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:background="@drawable/bg_yellow_r13"
                    android:orientation="vertical"
                    android:layout_marginTop="141dp"
                    android:paddingHorizontal="17dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llImageToPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_image_to_pdf" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/image_to_pdf" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/llMergePDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_merge_pdf" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/merge_to_pdf" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llSplitPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_split_pdf" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/split" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/llScanPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_scan" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/scan_to_pdf" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llLockPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_lock" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/tools_label_lock" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/llUnlockPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_unlock" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/tools_label_unlock" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/llPrintPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_print_pdf" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/tools_print_title" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:id="@+id/llCompressPDF"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_r8"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:src="@mipmap/ic_tools_compress" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/compress" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="157dp"
                    android:layout_gravity="top|start"
                    android:contentDescription="@string/tools"
                    android:src="@mipmap/bg_tools" />

            </FrameLayout>
        </LinearLayout>

    </ScrollView>

    <com.peng.pdfreader.core.widget.AdSlotView
        android:id="@+id/adBanner"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
