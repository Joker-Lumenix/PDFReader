<?xml version="1.0" encoding="utf-8"?>
<!--
  Tools tab.

  Layout per design "tools" (360x760):
  - app bar 0..87 (#fafafa) with the title at x=20
  - hero illustration 320x157 at (20, 95)
  - yellow panel 320x420 at (20, 236), radius 13
  - 2 x 4 grid of 133x82 tool cards, first card at (37, 252)

  The shared title bar ends at 89 (24 status bar + 64 bar + 1 hairline), the
  offsets below are therefore 2 smaller than the y of the design.

  The yellow panel is drawn behind the illustration and behind the grid, which
  is how the design stacks them; the radius is applied in code because the
  panel colour only exists in the design.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginHorizontal="@dimen/dsg_radius_20"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- yellow panel, the surface of the tool grid -->
            <View
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_gravity="top|start"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="147dp" />

            <!-- the 2 x 4 grid of the tools -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTools"
                android:layout_width="match_parent"
                android:layout_height="388dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="163dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <!-- hero illustration, drawn on top of the yellow panel -->
            <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="320dp"
                android:layout_height="157dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/tools"
                android:src="@mipmap/bg_tools" />

            <!--
              banner ad of the design, it sits below the grid of the tools.
              The app does not bundle an ad sdk, the slot only reserves the
              space and renders the local sample.
            -->
            <com.peng.pdfreader.appcore.widget.AdSlotView
                android:id="@+id/adBanner"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="563dp"
                android:layout_marginEnd="12dp" />

        </FrameLayout>


    </androidx.core.widget.NestedScrollView>

</LinearLayout>
