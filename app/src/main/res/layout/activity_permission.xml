<?xml version="1.0" encoding="utf-8"?>
<!--
  "Allow access to all files" page: the hero illustration with the state card
  and the permission switch, the rationale and the allow button.

  Geometry of the design: the hero 320x286dp with a 21dp gap below the title
  bar, the white card 320x58dp inside the lower third of the hero, the
  heading 36dp below the hero and the 312x48dp button at the bottom.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/surface_card"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/flBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        >

        <View
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:background="@drawable/gradient_bg_permission"
            />

        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="match_parent"
            android:layout_height="286dp"
            android:layout_marginTop="84dp"
            android:layout_marginHorizontal="20dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/bg_file_access" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_close"
            android:layout_gravity="right|top"
            android:layout_margin="20dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/flBg"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="@dimen/space_l"
        android:includeFontPadding="false"
        android:text="@string/permission_required"
        android:textColor="@color/text_secondary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        android:layout_marginEnd="@dimen/space_l"
        android:lineSpacingExtra="7.5dp"
        android:text="@string/permission_rationale"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="@dimen/space_xxl"
        android:background="@drawable/gradient_red"
        android:backgroundTint="@null"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/allow"
        android:textColor="@color/text_on_tint"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
