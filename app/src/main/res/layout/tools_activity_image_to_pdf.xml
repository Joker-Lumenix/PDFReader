<?xml version="1.0" encoding="utf-8"?>
<!--
  "Image to PDF" flow (designs "Image to PDF", "Image to PDF-loading",
  "Image to PDF空状态", "Image to PDF下拉").

  Geometry of the design (360x760):
  - app bar with the title at x=52 and the picture action at x=181
  - image tiles 104x104 at x = 12 / 128 / 244, rows at y = 92 / 208 / 324
  - bottom sheet 360x164 at y=596, #fffdfd, radius 16 on the top corners
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- the header of the design carries the picture action next to the title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="63dp"
                android:background="@color/surface_card"
                >

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="20dp"
                    android:layout_alignParentLeft="true"
                    android:contentDescription="@string/label_back"
                    android:src="@drawable/ic_arrow_back"
                    android:layout_centerVertical="true"
                    />

                <TextView
                    android:id="@+id/tvTitle"
                    android:textSize="15sp"
                    android:textColor="#ff060606"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:maxWidth="150dp"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivBack"
                    android:ellipsize="end"
                    android:layout_centerVertical="true"
                    android:maxLines="1"
                    android:layout_marginStart="7dp"
                    tools:text="标题"
                    />

                <ImageView
                    android:id="@+id/ivChangeCameraGroup"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/ic_arrow_down"
                    android:layout_toEndOf="@+id/tvTitle"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="7dp"
                    />

            </RelativeLayout>

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start|top"
                android:layout_marginStart="181dp"
                android:layout_marginTop="44dp"
                android:clickable="true"
                android:contentDescription="@string/tools_image_add"
                android:focusable="true" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="3dp"
                android:scrollbars="none" />

            <!-- the empty state of the design "Image to PDF空状态" -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginTop="211dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/no_permissions"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/authorization_required"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnGoToSet"
                    android:layout_width="137dp"
                    android:layout_height="43dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/gradient_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/tools_image_go_to_set"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- bottom sheet of the design, it is part of the screen and not a dialog -->
        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_top_r16"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <TextView
                    android:id="@+id/tvSheetTitle"
                    style="@style/TextAppearance.AppCore.SheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:text="@string/tools_image_select" />

                <TextView
                    android:id="@+id/btnImport"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/gradient_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/text_on_tint"
                    android:textSize="14sp" />

            </FrameLayout>

            <HorizontalScrollView
                android:id="@+id/stripScroll"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/tools_image_strip"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/strip"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
