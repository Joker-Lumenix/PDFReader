<?xml version="1.0" encoding="utf-8"?>
<!--
  Feedback page: heading and illustration on top of each other, a large
  multi line input and the submit button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_subtle"
    android:orientation="vertical">

    <com.peng.pdfreader.appcore.widget.PageTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_weight="1"
        android:background="@drawable/bg_card_r8"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_primary"
                android:textSize="20sp"
                tools:text="What issues did you face?" />

            <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="116dp"
                android:layout_height="84dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@mipmap/bg_feedback" />
        </LinearLayout>

        <EditText
            android:id="@+id/etFeedback"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/feedback_input_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="@color/text_secondary"
            android:textColorHint="@color/text_placeholder_pink"
            android:textSize="15sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="@dimen/space_xxl"
        android:background="@drawable/gradient_red"
        android:backgroundTint="@null"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/submit"
        android:textColor="@color/text_on_tint"
        android:textSize="16sp" />

</LinearLayout>
