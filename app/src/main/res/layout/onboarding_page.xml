<?xml version="1.0" encoding="utf-8"?>
<!--
  One page of the onboarding: the 360x580dp hero image on top, the title and
  the subtitle underneath, both left aligned with a 24dp margin.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivIllustration"
                android:layout_width="match_parent"
                android:layout_height="580dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@mipmap/bg_guide_1" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Convert Image to PDF" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="9dp"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                tools:text="One-click fast conversion" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
