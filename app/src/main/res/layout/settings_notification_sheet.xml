<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom sheet that asks for the notification permission (Android 13+).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="@dimen/space_xxl">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/settings_close"
            android:src="@mipmap/ic_close" />
    </FrameLayout>

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="280dp"
        android:layout_height="250dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@mipmap/bg_rate_cloud" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/turn_on_notifications"
        android:textColor="@color/text_secondary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/notification_rationale"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTurnOn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/gradient_red"
        android:backgroundTint="@null"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/turn_on_now"
        android:textColor="@color/text_on_tint"
        android:textSize="16sp" />

</LinearLayout>
