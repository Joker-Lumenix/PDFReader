<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom sheet that asks for the notification permission (Android 13+).

  Geometry of the design: the close button 12dp below the top edge of the
  sheet, the 280x250dp hero 36dp below it, then 20dp to the title, 20dp to the
  body, 32dp to the button and 32dp to the bottom edge (501dp sheet).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="280dp"
            android:layout_height="250dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="36dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@mipmap/bg_file_access" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/space_l"
            android:gravity="start"
            android:includeFontPadding="false"
            android:text="@string/turn_on_notifications"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/space_l"
            android:gravity="start"
            android:includeFontPadding="false"
            android:lineSpacingExtra="7.5dp"
            android:text="@string/notification_rationale"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTurnOn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="@dimen/space_xxl"
            android:background="@drawable/gradient_red"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="@string/turn_on_now"
            android:textColor="@color/text_on_tint"
            android:textSize="16sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/settings_close"
        android:src="@mipmap/ic_close" />

</FrameLayout>
