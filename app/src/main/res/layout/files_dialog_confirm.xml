<?xml version="1.0" encoding="utf-8"?>
<!--
  Second level confirmation (design: 删除二次确认 / 保存二次确认).

  336x266 card, 112x112 illustration, the body copy and the cancel / confirm
  pair at the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/ivIllustration"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@mipmap/bg_file_save" />

    <TextView
        android:id="@+id/tvMessage"
        style="@style/TextAppearance.AppCore.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:gravity="start"
        android:lineSpacingExtra="10dp"
        android:textColor="@color/text_placeholder"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_unable_r16"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/cancel" />

        <Space
            android:layout_width="22dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnConfirm"
            style="@style/TextAppearance.AppCore.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/gradient_red"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/delete" />
    </LinearLayout>

</LinearLayout>
