<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick entry popup: a small panel with an icon header and a list of draggable
  entries. The panel background is applied in code because the header and the
  list carry different corner radii.

  Geometry of the design: the panel is 156dp wide, the header 36dp tall with
  four 20dp icons 39dp apart, every entry 36dp tall.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="9dp">

        <ImageView
            android:id="@+id/ivHeaderAlert"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="19dp"
            android:contentDescription="@string/quick_entry_header_alert"
            tools:src="@mipmap/ic_add_circle" />

        <ImageView
            android:id="@+id/ivHeaderDelete"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="19dp"
            android:contentDescription="@string/delete"
            tools:src="@mipmap/ic_delete_black" />

        <ImageView
            android:id="@+id/ivHeaderShare"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="19dp"
            android:contentDescription="@string/share"
            tools:src="@mipmap/ic_share_red" />

        <ImageView
            android:id="@+id/ivHeaderEdit"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/quick_entry_header_edit"
            tools:src="@mipmap/ic_edit_black" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
