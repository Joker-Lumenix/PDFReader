<?xml version="1.0" encoding="utf-8"?>
<!--
  Password sheet of the lock / unlock flow.

  Layout per design (Moonvy "lock密码输入", "lock输入", "lock错误",
  "密码输入", "密码错误", "密码可见输入", "密码可见错误",
  "lock密码可见输入_2"):
  sheet 360x232 starting at y=279, title 18/600 at x=20,y=303, subtitle
  11/400 at y=327, input 316x48 at x=20,y=363 with the 20dp eye glyph at
  x=304,y=377, error row (14dp icon + 11/400 message) at y=415, the two
  48dp buttons at y=443.
  The error row keeps its place in the neutral state so the sheet always
  measures 232dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="232dp"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextAppearance.AppCore.SheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:layout_marginTop="24dp"
        />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:textColor="@color/text_placeholder"
        android:textSize="11sp" />

    <!-- password field -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp">

        <EditText
            android:id="@+id/etPassword"
            style="@style/Widget.AppCore.InputField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:hint="@string/lock_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingEnd="36dp"
            android:textColor="@color/text_secondary" />

        <!-- visibility toggle, the design shows the closed eye while the
             password is hidden and the open eye while it is shown -->
        <ImageView
            android:id="@+id/ivToggle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/lock_toggle_password"
            android:src="@mipmap/ic_eye_close" />

    </FrameLayout>

    <!-- error row: invisible in the neutral state, it keeps the height -->
    <LinearLayout
        android:id="@+id/errorRow"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/ivError"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@mipmap/ic_warn_red"
            android:contentDescription="@string/lock_operation_failed" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/brand_primary_light"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            style="@style/Widget.AppCore.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/cancel"
            android:textAppearance="@style/TextAppearance.AppCore.Button" />

        <TextView
            android:id="@+id/btnOk"
            style="@style/Widget.AppCore.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="34dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/ok"
            android:textAppearance="@style/TextAppearance.AppCore.Button" />

    </LinearLayout>

</LinearLayout>
