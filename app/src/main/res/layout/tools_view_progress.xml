<?xml version="1.0" encoding="utf-8"?>
<!--
  The progress of a running job (design: merging).

  It is the shared body of the progress page, every tool of the app shows it
  while it builds a document.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/progressCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_r8" />

    <ImageView
        android:id="@+id/ivProgressArt"
        android:layout_width="127dp"
        android:layout_height="162dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="88dp"
        android:contentDescription="@null"
        android:src="@mipmap/bg_deal_progress" />

    <TextView
        android:id="@+id/tvProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="278dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/brand_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvProgressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="304dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- the progress track of the design: 240x6 with a handle -->
    <FrameLayout
        android:id="@+id/progressHolder"
        android:layout_width="240dp"
        android:layout_height="24dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="354dp">

        <View
            android:id="@+id/progressTrack"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/progressFill"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_gravity="start|center_vertical" />

        <ImageView
            android:id="@+id/progressKnob"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null" />

    </FrameLayout>

</FrameLayout>
