<?xml version="1.0" encoding="utf-8"?>
<!--
  The ad card of the design (312x118): the app icon, the title, the AD badge,
  the description and the wide install button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:background="@drawable/bg_ad_card"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="@string/label_ad_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.AppCore.AdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvDescription"
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadge"
            style="@style/TextAppearance.AppCore.TypeChip"
            android:layout_width="28dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_ad_badge_card"
            android:gravity="center"
            android:textColor="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAction"
        style="@style/TextAppearance.AppCore.AdActionLarge"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_ad_action_card"
        android:gravity="center"
        android:textColor="@color/white" />

</LinearLayout>
