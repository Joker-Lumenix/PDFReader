<?xml version="1.0" encoding="utf-8"?>
<!--
  A page tile of the split screen (design "Split PDF").

  The tile is 104x124 on a 360 wide screen, the three tiles of a row share the
  width of the screen, so the height follows the width (124 / 104). The tile
  carries the page number badge in its top left corner (18x18, radius 4). The
  badge colour is applied in code - green when the page is selected,
  translucent black when it is not.
-->
<com.peng.pdfreader.core.widget.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:ratio="1.1923">

    <ImageView
        android:id="@+id/ivPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_r4"
        android:clipToOutline="true"
        android:contentDescription="@string/tools_split_title"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white" />

</com.peng.pdfreader.core.widget.RatioFrameLayout>
