<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      File access: on Android 11 and above the app asks for the "all files"
      access, below that the plain read permission is enough.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The notifications are a runtime permission on Android 13 and above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The scanner of the tools uses the camera. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".PdfReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfReader">

        <!-- The start up screen is the entry point of the app. -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PdfReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The quick access of the launcher: the shortcuts show up when the
              app icon is pressed and held in the system launcher.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PdfReader"
            android:windowSoftInputMode="adjustResize">

            <!-- Open documents from other apps / file managers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>

            <!-- Share a document into the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>

        <!-- Preview and annotation editors -->
        <activity
            android:name=".feature.preview.activity.PreviewActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".feature.preview.activity.SignatureActivity"
            android:exported="false" />

        <activity
            android:name=".feature.preview.activity.DrawActivity"
            android:exported="false" />

        <!-- PDF tools -->
        <activity
            android:name=".feature.tools.activity.MergeActivity"
            android:exported="false" />

        <activity
            android:name=".feature.tools.activity.SplitActivity"
            android:exported="false" />

        <activity
            android:name=".feature.tools.activity.ImageToPdfActivity"
            android:exported="false" />

        <activity
            android:name=".feature.tools.activity.CompressActivity"
            android:exported="false" />

        <activity
            android:name=".feature.tools.scanner.ScanActivity"
            android:exported="false" />

        <!-- Encryption -->
        <activity
            android:name=".feature.lock.activity.LockActivity"
            android:exported="false" />

        <activity
            android:name=".feature.lock.activity.UnlockActivity"
            android:exported="false" />

        <!-- Settings, language, feedback and onboarding -->
        <activity
            android:name=".feature.language.LanguageActivity"
            android:exported="false" />

        <activity
            android:name=".feature.feedback.FeedbackActivity"
            android:exported="false" />

        <activity
            android:name=".feature.settings.notice.NoticeActivity"
            android:exported="false" />

        <activity
            android:name=".feature.settings.rating.RatingActivity"
            android:exported="false" />

        <!-- The file permission step of the start up flow. -->
        <activity
            android:name=".ui.permission.PermissionActivity"
            android:exported="false" />

        <!-- The guide of the first start. -->
        <activity
            android:name=".feature.guide.GuideActivity"
            android:exported="false" />

        <!-- The file search and the file picker of the home tab. -->
        <activity
            android:name=".feature.files.activity.FileSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".feature.files.activity.FileSelectActivity"
            android:exported="false" />

        <!-- Keeps the chosen app locale across restarts on Android 12 and below. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Grants temporary read access to a sandbox file when it is shared. -->
        <provider
            android:name=".base.ShareFileProvider"
            android:authorities="com.peng.pdfreader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
