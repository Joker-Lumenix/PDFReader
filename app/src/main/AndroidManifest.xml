<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      File access: on Android 11 and above the app asks for the "all files"
      access, below that the plain read permission is enough.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The notifications are a runtime permission on Android 13 and above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The timer of the notifications runs in the foreground, so the system does
      not stop it while the app is in the background.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The alarms of the app send the notifications with a delay. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The app does not use the camera api itself, the Google document scanner
      and the system camera do the capture. So the camera permission must not
      be declared - a declared but not granted permission would block the
      camera intent.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".PdfReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdfReader"
        android:requestLegacyExternalStorage="true">

        <!--
          The id of the AdMob app. It points at the public test app of Google,
          the owner replaces it with the id of the own AdMob account.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          The automatic initialisation of the Google sdk is switched off: the
          providers run before the first activity and a missing or still
          placeholder configuration would take the app down before the splash
          screen is visible. The app starts the sdk itself, in a guarded way.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />

        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            android:exported="false"
            tools:node="remove" />

        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PdfReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PdfReader"
            android:windowSoftInputMode="adjustResize">

            <!-- Open documents from other apps / file managers. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>

            <!-- Share a document into the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>

        <!-- Preview and annotation editors -->
        <activity
            android:name=".ui.activities.PreviewActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.activities.SignatureActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.DrawActivity"
            android:exported="false" />

        <!-- PDF tools -->
        <activity
            android:name=".ui.activities.MergeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.SplitActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ImageToPdfActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ImageProcessActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ImageViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ImageAlbumActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.CompressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ScanActivity"
            android:exported="false" />

        <!-- The file selection page of the PDF tools -->

        <activity
            android:name=".ui.activities.ToolFilePickerActivity"
            android:exported="false" />

        <!-- Settings, language, feedback and onboarding -->
        <activity
            android:name=".ui.activities.LanguageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.FeedbackActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.NoticeActivity"
            android:exported="false" />

        <!-- The file permission step of the start up flow. -->
        <activity
            android:name=".ui.activities.PermissionActivity"
            android:exported="false" />

        <!-- The guide of the first start. -->
        <activity
            android:name=".ui.activities.GuideActivity"
            android:exported="false" />

        <!-- The file search and the file picker of the home tab. -->
        <activity
            android:name=".ui.activities.FileSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.activities.FileSelectActivity"
            android:exported="false" />

        <!--
          The pages the tools of the app share: the progress page shows the
          running job, the result page shows what it produced.
        -->
        <activity
            android:name=".ui.activities.ToolProgressActivity"
            android:exported="false" />

        <activity
            android:name=".ui.activities.ResultActivity"
            android:exported="false" />

        <!-- Keeps the chosen app locale across restarts on Android 12 and below. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          The notifications of the app: the timer of the notifications, the
          events of the system and the messages of firebase.
        -->
        <service
            android:name=".notification.trigger.NotificationTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="the timer of the notifications of the app" />
        </service>

        <service
            android:name=".notification.trigger.NotificationFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notification.trigger.NotificationUnlockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.trigger.NotificationAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.peng.pdfreader.action.NOTIFICATION_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Grants temporary read access to a sandbox file when it is shared. -->
        <provider
            android:name=".base.ShareFileProvider"
            android:authorities="com.peng.pdfreader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
