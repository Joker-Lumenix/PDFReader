<?xml version="1.0" encoding="utf-8"?>
<!--
  The brand progress bar of the start up screen: a soft track with the brand
  gradient filling it from left to right.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_border_subtle" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/brand_primary"
                    android:startColor="@color/brand_primary_light" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
