<?xml version="1.0" encoding="utf-8"?>
<!--
  Design system theme.
  Colours / spacing / type scale all come from the Moonvy token dump
  (values/colors.xml, values/dimens.xml, values/type.xml).
  Light only - the design ships no dark scheme.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AppCore" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_tint</item>
        <item name="colorSecondary">@color/brand_primary_dark</item>
        <item name="colorSecondaryVariant">@color/status_error_deep</item>
        <item name="colorOnSecondary">@color/text_on_tint</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_tertiary</item>
        <item name="colorError">@color/status_error_crimson</item>
        <item name="android:colorBackground">@color/surface_subtle</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AppCore.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AppCore.Dialog</item>
    </style>

    <style name="ThemeOverlay.AppCore.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.AppCore.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_white_alt</item>
        <!--
          The sheets with a text field have to sit above the keyboard, the
          design shows them right above it.
        -->
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.AppCore.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_white_alt</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AppCore.BottomSheet</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Bottom sheet: top corners 16dp, bottom square - straight from the design. -->
    <style name="ShapeAppearance.AppCore.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Centred dialog: uniform 16dp radius on all four corners. -->
    <style name="ShapeAppearance.AppCore.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="ThemeOverlay.AppCore.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.AppCore</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.AppCore.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AppCore.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AppCore.Button.Text</item>
    </style>

    <style name="MaterialAlertDialog.AppCore" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AppCore.Dialog</item>
        <item name="backgroundTint">@color/surface_white_alt</item>
    </style>

    <style name="MaterialAlertDialog.AppCore.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
