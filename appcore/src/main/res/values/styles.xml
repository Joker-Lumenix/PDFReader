<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget styles derived from the Moonvy design spec.
  Every value here is traceable to a measured token (colour / size / radius /
  type scale) - no invented values.
-->
<resources>

    <!-- ==================== type scale ==================== -->

    <!-- Top bar title: 20sp / 700 / #060606 -->
    <style name="TextAppearance.AppCore.PageTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Top bar subtitle: 12sp / 400 / #999999 -->
    <style name="TextAppearance.AppCore.PageSubtitle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_placeholder</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Sheet / dialog title: 18sp / 600 / #333333 -->
    <style name="TextAppearance.AppCore.SheetTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Sheet subtitle: 12sp / 400 / #999999 -->
    <style name="TextAppearance.AppCore.SheetSubtitle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_placeholder</item>
    </style>

    <!-- List item title: 15sp / 600 / #333333 -->
    <style name="TextAppearance.AppCore.ItemTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Body copy: 14sp / 400 / #333333 -->
    <style name="TextAppearance.AppCore.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Meta line: 12sp / 400 / #999999 -->
    <style name="TextAppearance.AppCore.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_placeholder</item>
    </style>

    <!-- File type chip label: 10sp / 700 -->
    <style name="TextAppearance.AppCore.TypeChip" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Primary button label: 16sp / 500 / #f8fbff -->
    <style name="TextAppearance.AppCore.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_on_tint</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Bottom navigation label: 12sp / 500 -->
    <style name="TextAppearance.AppCore.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_accent_neutral</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Section header: 14sp / 600 / #333333 -->
    <style name="TextAppearance.AppCore.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ==================== widgets ==================== -->

    <!-- Primary CTA: brand gradient, 16dp radius, 48dp tall -->
    <style name="Widget.AppCore.PrimaryButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/gradient_red</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary CTA: #c4c4c4, 16dp radius, 48dp tall -->
    <style name="Widget.AppCore.SecondaryButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_btn_unable_r16</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Pill CTA: 40dp tall, 20dp radius -->
    <style name="Widget.AppCore.PillButton" parent="Widget.AppCore.PrimaryButton">
        <item name="android:background">@drawable/bg_white_r36</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Card surface used by list rows and settings rows -->
    <style name="Widget.AppCore.Card" parent="">
        <item name="android:background">@drawable/bg_card_r8</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Settings row surface: 4dp radius -->
    <style name="Widget.AppCore.SettingsRow" parent="">
        <item name="android:background">@drawable/bg_card_r4</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Text input: #f4f4f4, 12dp radius, 48dp tall -->
    <style name="Widget.AppCore.InputField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edit_r12</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- File type chip: #efefef pill with a coloured label -->
    <style name="Widget.AppCore.TypeChip" parent="">
        <item name="android:background">@drawable/bg_type_chip</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Icon tile behind quick actions: #fff2f2, 6.4dp radius -->
    <style name="Widget.AppCore.IconTile" parent="">
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.AppCore.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_on_tint</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ==================== animations ==================== -->

    <style name="Animation.AppCore.Dialog" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/appcore_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/appcore_dialog_exit</item>
    </style>

</resources>
