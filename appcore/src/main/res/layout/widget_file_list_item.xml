<?xml version="1.0" encoding="utf-8"?>
<!--
  File list item - the single template required by the spec.
  Every state (normal / multi select / search hit / advertising row) is driven
  by visibility switches on the same layout, there is no second xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_card_r8"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- multi select checkbox -->
    <ImageView
        android:id="@+id/ivCheckbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/appcore_select"
        android:visibility="gone" />

    <!-- 48x48 thumbnail / file type logo -->
    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/appcore_file_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.AppCore.ItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- advertising badge, hidden for normal rows -->
            <TextView
                android:id="@+id/tvBadge"
                style="@style/TextAppearance.AppCore.TypeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_purple"
                android:textColor="@color/white"
                android:visibility="gone" />

            <!-- inline action button (Install), hidden by default -->
            <TextView
                android:id="@+id/tvInlineAction"
                style="@style/TextAppearance.AppCore.Body"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/gradient_red"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- file type pill -->
            <TextView
                android:id="@+id/tvType"
                style="@style/Widget.AppCore.TypeChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textAppearance="@style/TextAppearance.AppCore.TypeChip" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/TextAppearance.AppCore.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- "more" affordance -->
    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/appcore_more"
        android:src="@drawable/ic_more_dots" />

</LinearLayout>
